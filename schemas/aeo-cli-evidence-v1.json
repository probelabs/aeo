{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://probelabs.com/schema/aeo-cli-evidence-v1.json",
  "title": "aeo-cli-evidence-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace", "run", "prompts"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "aeo-cli-evidence-v1"
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["brand", "domain", "aliases", "competitors"],
      "properties": {
        "brand": { "type": "string" },
        "domain": { "type": "string" },
        "aliases": {
          "type": "array",
          "items": { "type": "string" }
        },
        "competitors": {
          "type": "array",
          "items": { "type": "string" }
        },
        "competitor_aliases": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "timestamp",
        "methodology_version",
        "engines",
        "samples_per_arm"
      ],
      "properties": {
        "run_id": { "type": "string", "minLength": 1 },
        "timestamp": { "type": "string", "minLength": 1 },
        "methodology_version": { "type": "string", "const": "aeo-cli-v1" },
        "engines": {
          "type": "array",
          "items": { "type": "string", "enum": ["claude", "codex", "grok"] }
        },
        "samples_per_arm": { "type": "integer", "minimum": 1 },
        "comment": { "type": "string" },
        "measurement_set": {
          "type": "object",
          "description": "Frozen question set this run measured (aeo.measurement): id, version, question_hash, declared_hash, matches, counts."
        },
        "environment": {
          "type": "object",
          "description": "Per engine: cli, cli_version, argv per arm (question replaced by <prompt>), isolation settings and the identity canary result.",
          "additionalProperties": { "type": "object" }
        }
      }
    },
    "prompts": {
      "type": "array",
      "items": { "$ref": "#/$defs/PromptResult" }
    },
    "mention_rate_knowledge": { "type": "number", "minimum": 0, "maximum": 1 },
    "mention_rate_search": { "type": "number", "minimum": 0, "maximum": 1 },
    "search_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "vendor_prebelief_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "tokens_input": { "type": "number", "minimum": 0 },
    "tokens_output": { "type": "number", "minimum": 0 },
    "tokens_total": { "type": "number", "minimum": 0 },
    "cost_usd": { "type": "number", "minimum": 0 }
  },
  "$defs": {
    "ArmResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_response_text",
        "brand_mentioned",
        "brand_mentions",
        "competitor_mentions",
        "searched",
        "search_queries",
        "vendors_in_search_queries",
        "recommended"
      ],
      "properties": {
        "raw_response_text": { "type": "string" },
        "brand_mentioned": { "type": "boolean" },
        "brand_mentions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "competitor_mentions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "searched": { "type": "boolean" },
        "search_queries": {
          "type": "array",
          "items": { "type": "string" }
        },
        "vendors_in_search_queries": {
          "type": "array",
          "items": { "type": "string" }
        },
        "recommended": { "type": "boolean" },
        "error": { "type": "string" },
        "brand_cited": { "type": "boolean", "description": "A link to the brand's domain is among the answer's sources." },
        "browsing": {
          "type": "string",
          "enum": ["none", "searched", "unknown"],
          "description": "none = complete event stream with no search or fetch; searched = search or fetch observed; unknown = cannot be confirmed."
        },
        "tool_activity": {
          "type": "object",
          "properties": {
            "tools_available": { "type": ["array", "null"], "items": { "type": "string" } },
            "tools_used": { "type": "array", "items": { "type": "string" } },
            "stream_complete": { "type": "boolean" }
          }
        },
        "model": { "type": "string" },
        "isolated": { "type": "boolean", "description": "Ran in a fresh engine home with no user identity, memory, instructions, MCP or hooks." },
        "retrieval": {
          "type": "object",
          "description": "query -> returned results -> pages opened -> sources cited; brand = where the brand's site appeared or dropped out.",
          "properties": {
            "steps": { "type": "array", "items": { "type": "object" } },
            "results_exposed": { "type": "boolean" },
            "cited_urls": { "type": "array", "items": { "type": "string" } },
            "gaps": { "type": "array", "items": { "type": "string" } },
            "brand": { "type": "object" }
          }
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "cache_read_tokens": { "type": "integer", "minimum": 0 },
            "cache_write_tokens": { "type": "integer", "minimum": 0 },
            "total_tokens": { "type": "integer", "minimum": 0 },
            "cost_usd": { "type": "number", "minimum": 0 }
          }
        }
      }
    },
    "EngineArms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "knowledge": { "$ref": "#/$defs/ArmResult" },
        "search": { "$ref": "#/$defs/ArmResult" }
      }
    },
    "PromptResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt_id", "prompt_text", "engines"],
      "properties": {
        "prompt_id": { "type": "string" },
        "prompt_text": { "type": "string" },
        "intent": { "type": "string" },
        "class": { "type": "string", "enum": ["watch", "focus"] },
        "why": { "type": "string" },
        "sample_index": { "type": "integer", "minimum": 1 },
        "group": { "type": "string", "enum": ["measurement", "exploratory"] },
        "engines": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "claude": { "$ref": "#/$defs/EngineArms" },
            "codex": { "$ref": "#/$defs/EngineArms" },
            "grok": { "$ref": "#/$defs/EngineArms" }
          }
        }
      }
    }
  }
}
